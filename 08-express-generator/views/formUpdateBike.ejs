<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Añadir bicicleta</title>
    <%- include("modules/links") %>
  </head>
  <body>
    <header>
        <%- include("modules/navbar.ejs") %>
    </header>
    <main>
      <div class="d-flex justify-content-center pt-5">
        <form 
            action="/bikes/updateBike/<%= bike.bike_id %>"
            method="post" 
            enctype="multipart/form-data"
            class="border border-1 rounded-2 mt-5 p-3"
        >
          <h3>Formulario Edición bibicleta</h3>

          <div class="mb-3">
            <label for="inputBrand" class="form-label">Marca</label>
            <input
              name="brand"
              type="text"
              class="form-control"
              id="inputBrand"
              aria-describedby="emailHelp"
              value=<%= bike.brand %>
              />
            </div>
            
            <div class="mb-3">
                <label for="inputModelo" class="form-label">Modelo</label>
                <input 
                name="model"    
                type="text" 
                class="form-control" 
                id="inputModelo" 
                value=<%= bike.model %>
                />
            </div>
            
            <div class="mb-3">
                <label for="inputPrice" class="form-label">Price</label>
                <input 
                name="price"
                type="text" 
                class="form-control" 
                id="inputPrice" 
                value=<%= bike.price %>
            />
          </div>

          <div class="mb-3">
            <label for="inputPicture" class="form-label">Sube una foto</label>
            <input 
                type="file"
                class="form-control" 
                id="inputPicture" 
                name="img"    
            />
          </div>


          <div class="d-flex gap-2 pb-3">
              <div class="form-check">
                  <input
                    class="form-check-input"
                    type="radio"
                    name="type"
                    id="radioDefault1"
                    value="2"
                    <%= bike.type == 2 ? 'checked' : '' %>
                    />
                    <label class="form-check-label" for="radioDefault1">
                        Manual
                    </label>
                </div>
                <div class="form-check">
                    <input
                    class="form-check-input"
                    type="radio"
                    name="type"
                    id="radioDefault2"
                    value="1"
                     <%= bike.type == 1 ? 'checked' : '' %>
                    />
                    <label class="form-check-label" for="radioDefault2">
                        Eléctrica
                    </label>
                </div>
            </div>

          <button type="submit" class="btn btn-primary">Submit</button>
          <button type="reset" class="btn btn-primary">Reset</button>
        </form>
      </div>
    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
