<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>home-hospitak</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <header>
      <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
          <a class="navbar-brand" href="#">Navbar</a>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="/">Home</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/services">servicios</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/doctor/allDoctors">Equipo médico</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/specialty/allSpecialty"
                  >Especialidades</a
                >
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/admin">Administración</a>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </header>
    <main>
      <h1>Página Administrador</h1>
      <section>
        <div class="d-flex justify-content-center gap-2">
          <div class="border border-1 rounded-2 p-4">
            <h3>Añadir Especialidad</h3>
            <button onclick="window.location.href='/specialty/newSpecialty'">Añadir especialidad</button>
          </div>
          <div class="border border-1 rounded-2 p-4">
            <h3>Añadir Médico</h3>
            <button onclick="window.location.href='/doctor/newDoctor'">Añadir médico</button>
          </div>
        </div>
      </section>
      <section class="d-flex justify-content-evenly mt-5">
        <div class="border border-1 p-3">
          <h3>Especialidades</h3>


          <table class="table">
            <thead>
              <tr>
                <th scope="col">cod</th>
                <th scope="col">nombre</th>
                <th scope="col">descripción</th>
              </tr>
            </thead>
            <tbody>
              <% specialties.forEach(spec=>{ %>
                <tr>
                  <th scope="row"><%= spec.specialty_id %></th>
                  <td><%= spec.name %></td>
                  <td><%= spec.description %></td>
                </tr>
              <% }) %> 
            </tbody>
          </table>
        </div>



        <div class="border border-1 p-3">
          <h3>Médicos</h3>
          <table class="table">
            <thead>
              <tr>
                <th scope="col">doc</th>
                <th scope="col">Nombre</th>
                <th scope="col">Apellidos</th>
                <th scope="col">especialidad</th>
                <th scope="col">Ver perfil</th>

              </tr>
            </thead>
            <tbody>
              <% doctors.forEach(doc=>{ %>
                <tr>
                  <th scope="row"><%= doc.dorcot_id %></th>
                  <td><%= doc.name %></td>
                  <td><%= doc.lastname %></td>
                  <td><%= doc.especialidad %></td>
                  <td><img style="width: 70px; height: 70px;" src='/images/doctors/<%= doc.avatar?doc.avatar:"user.png" %>' alt=""></td>
                  <td><button onclick="window.location.href='/doctor/oneDoctor/<%= doc.doctor_id %>'">ver perfil</button></td>
                </tr>
              <% }) %>
            
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
