<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>home-hospitak</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <header>
      <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
          <a class="navbar-brand" href="#">Navbar</a>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link active" aria-current="page" href="/">Home</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/services">servicios</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/doctor/allDoctors">Equipo médico</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/specialty/allSpecialty">Especialidades</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/admin">Administración</a>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </header>
    <h1>Nuestras Especialidades</h1>
    <div class="d-flex flex-column align-items-center gap-3">
        <% result.forEach(elem=>{ %>
          <div class="border border-1 rounded-2 p-4 justify-content-center">
              <h3>Especialidad: <%= elem.name %> </h3>
              <p>Desc: <%= elem.description %></p>
          </div>
        <% }) %>
    </div>


    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
