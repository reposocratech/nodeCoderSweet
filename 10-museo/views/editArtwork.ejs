<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edicion obra</title>
    <%- include('modules/links') %>
    <link rel="stylesheet" href="/stylesheets/register.css" />
  </head>
  <body>
    <header><%- include('modules/navbar') %></header>
    <main>
      <div class="d-flex justify-content-center p-5">
        <form 
          class="w-25 border border-1 p-3 m-5" 
          action="/artwork/editArtwork/<%= artwork.artwork_id %>/<%= artwork.artist_id %>"
          method="post"
          enctype="multipart/form-data"
        >
          <h2>Formulario edición obra</h2>
          <div class="mb-3">
            <label for="inputTitle" class="form-label"
              >Título</label
            >
            <input
              type="text"
              class="form-control"
              id="inputTitle"
              aria-describedby="titleHelp"
              name="title"
              value="<%= artwork.title %>"
              />
            </div>
            
            <div class="mb-3">
                <label for="inputPrice" class="form-label"
                >Precio</label
                >
                <input
                    type="text"
                    class="form-control"
                    id="inputPrice"
                    aria-describedby="titleHelp"
                    name="price"
                    value="<%= artwork.price %>"
                />
          </div>
            <div class="mb-3">
                <label for="inputDescription" class="form-label"
                >Descripción</label
                >
                <input
                    type="text"
                    class="form-control"
                    id="inputPrice"
                    aria-describedby="DescriptionHelp"
                    name="description"
                    value="<%= artwork.description %>"
                />
          </div>
            <div class="mb-3">
                <label for="inputFoto" class="form-label"
                >Sube una foto</label
                >
                <input
                    type="file"
                    class="form-control"
                    id="inputFoto"
                    aria-describedby="DescriptionHelp"
                    name="img"
                />
          </div>


          <p class="msgErr"><%= typeof message != 'undefined' ? message : null%></p>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Submit</button>
            <button 
              type="button" 
              class="btn btn-primary"
              onclick="window.location.href='/artist/profile/'"
            >Cancelar</button>
          </div>
        
        </form>
      </div>
    </main>
    <%- include('modules/footer') %> <%- include('modules/scripts') %>
  </body>
</html>
