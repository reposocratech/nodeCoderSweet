<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login</title>
    <%- include('modules/links') %>
    <link rel="stylesheet" href="/stylesheets/register.css" />
  </head>
  <body>
    <header><%- include('modules/navbar') %></header>
    <main>
      <div class="d-flex justify-content-center p-5">
        <form 
          class="w-25 border border-1 p-3 m-5" 
          action="/artist/login"
          method="post"
        >
          <h2>Formulario login</h2>
          <div class="mb-3">
            <label for="inputEmail" class="form-label"
              >Email</label
            >
            <input
              type="email"
              class="form-control"
              id="inputEmail"
              aria-describedby="emailHelp"
              name="email"
            />
          </div>

          <div class="mb-3">
            <label for="inputPassword" class="form-label"
              >Password</label
            >
            <input
              type="text"
              class="form-control"
              id="inputPassword"
              name="password"
            />
          </div>
          <p class="msgErr"><%= typeof message != 'undefined' ? message : null%></p>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Submit</button>
            <button 
              type="button" 
              class="btn btn-primary"
              onclick="window.location.href='/'"
            >Cancelar</button>
          </div>
          <p>¿No estás registrado? <a href="/artist/register">Registrate aqui</a></p>
        </form>
      </div>
    </main>
    <%- include('modules/footer') %> <%- include('modules/scripts') %>
  </body>
</html>
